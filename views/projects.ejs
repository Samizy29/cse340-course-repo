<%- include('partials/header') %>

<h1><%= title %></h1>

<h2>Upcoming Service Projects</h2>
<ul>
  <% projects.forEach(function(project) { %>
    <li>
      <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>:
      <strong><%= project.title %></strong> (<%= project.organization_name %>)
      &mdash; <%= project.description %> at <%= project.location %>
    </li>
  <% }); %>
</ul>

<%- include('partials/footer') %>